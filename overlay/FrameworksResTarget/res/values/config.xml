    <!-- Color modes (Settings > Display > Colors): Natural, Boosted, Adaptive.
         Adaptive (persist.sys.sf.native_mode=2, system_ext.prop) is the default.
         Without any color mode ColorDisplayService never activates white balance
         (DisplayTransformManager.needsLinearColorMatrix() is false). -->
    <integer-array name="config_availableColorModes">
        <item>0</item>
        <item>1</item>
        <item>3</item>
    </integer-array>

    <!-- Display white balance ("Natural colors"): the tcs3408 RGB sensor reports the
         ambient color temperature in Kelvin as values[0] of qti.sensor.rgb.
         Ambient <3000K -> 5800K, 3000-4000 -> 6100, 4000-5000 -> 6500 (neutral),
         5000-6000 -> 7100, 6000-7000 -> 7800, 7000-8000 -> 8500, >8000 -> 9500;
         below 50 lux neutral, above 1000 lux 7500K. -->
    <bool name="config_displayWhiteBalanceAvailable">true</bool>
    <bool name="config_displayWhiteBalanceEnabledDefault">true</bool>
    <string name="config_displayWhiteBalanceColorTemperatureSensorName" translatable="false">qti.sensor.rgb</string>
    <integer name="config_displayWhiteBalanceColorTemperatureMin">5800</integer>
    <integer name="config_displayWhiteBalanceColorTemperatureMax">9500</integer>
    <array name="config_displayWhiteBalanceAmbientColorTemperatures">
        <item>2800.0</item>
        <item>3500.0</item>
        <item>4500.0</item>
        <item>5500.0</item>
        <item>6500.0</item>
        <item>7500.0</item>
        <item>8500.0</item>
    </array>
    <array name="config_displayWhiteBalanceDisplayColorTemperatures">
        <item>5800.0</item>
        <item>6100.0</item>
        <item>6500.0</item>
        <item>7100.0</item>
        <item>7800.0</item>
        <item>8500.0</item>
        <item>9500.0</item>
    </array>
    <!-- The low and high light values below are display CCTs: the ambient CCT
         is mapped to the display CCT first and then blended with these
         (DisplayWhiteBalanceController.updateAmbientColorTemperature). -->
    <array name="config_displayWhiteBalanceLowLightAmbientBrightnesses">
        <item>40.0</item>
        <item>50.0</item>
    </array>
    <array name="config_displayWhiteBalanceLowLightAmbientBiases">
        <item>0.0</item>
        <item>1.0</item>
    </array>
    <item name="config_displayWhiteBalanceLowLightAmbientColorTemperature" format="float" type="dimen">6500.0</item>
