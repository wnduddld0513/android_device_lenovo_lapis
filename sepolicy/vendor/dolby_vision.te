# Dolby Vision, labeled as in the stock vendor policy.

# Decoder Codec2 store "default8" (vendor.dolby.media.c2-service-vision)
type vendorcodec, domain, dvs_aidl_client;
type vendorcodec_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(vendorcodec)
hal_server_domain(vendorcodec, hal_codec2)
hal_client_domain(vendorcodec, hal_allocator)
hal_client_domain(vendorcodec, hal_graphics_allocator)
hal_client_domain(vendorcodec, hal_sensors)
vndbinder_use(vendorcodec)

# The A17 service asks init for CAP_SYS_NICE (capabilities SYS_NICE)
allow vendorcodec self:capability sys_nice;

allow vendorcodec dmabuf_system_heap_device:chr_file r_file_perms;
allow vendorcodec gpu_device:chr_file rw_file_perms;
allow vendorcodec fwk_sensor_hwservice:hwservice_manager find;
allow vendorcodec fwk_sensor_service:service_manager find;
r_dir_file(vendorcodec, vendor_sysfs_graphics)
allow vendorcodec vendor_sysfs_kgsl:file r_file_perms;
allow hal_graphics_composer_default vendorcodec:fd use;

# DVS daemon (dvs-aidl-service): picture modes and the panel brightness fed
# by DolbyVisionService (system_app)
type dvs_aidl_default, domain, dvs_aidl_server;
type dvs_aidl_default_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(dvs_aidl_default)
binder_use(dvs_aidl_default)
add_service(dvs_aidl_default, dvs_aidl_service)
allow dvs_aidl_default fwk_sensor_hwservice:hwservice_manager find;
allow dvs_aidl_default fwk_sensor_service:service_manager find;
binder_call(dvs_aidl_default, system_server)
r_dir_file(dvs_aidl_default, vendor_sysfs_graphics)
set_prop(dvs_aidl_server, vendor_dolbyv_prop)

typeattribute system_app dvs_aidl_client;
binder_call(dvs_aidl_client, dvs_aidl_server)
binder_call(dvs_aidl_server, dvs_aidl_client)
allow dvs_aidl_client dvs_aidl_service:service_manager find;
